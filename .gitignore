# Secrets. .env carries the archive master key; committing it would publish the key that
# every archived document is encrypted under.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Benchmark output — regenerated deterministically by tests/benchmark/generate.py, so
# there is no reason to carry ~1MB of PDFs in the repo.
bench/
tests/benchmark/bench/

# Local state
*.db
*.sqlite3
archive/
