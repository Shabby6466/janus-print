#!/usr/bin/python3
"""janus-print CUPS backend — the interception point.

Installed as /usr/lib/cups/backend/janus, mode 0700, owned by root. CUPS runs it as the
`lp` user for every job on every queue it fronts. Its exit code is the verdict:

    0  CUPS_BACKEND_OK      release  -> exec the real backend
    3  CUPS_BACKEND_HOLD    hold     -> job stays in the queue, releasable by an analyst
    5  CUPS_BACKEND_CANCEL  block    -> job destroyed

Device URI shape — the real scheme is the first path segment:

    janus://ipp/10.0.4.21/ipp/print   ->  ipp://10.0.4.21/ipp/print
    janus://socket/10.0.4.9:9100      ->  socket://10.0.4.9:9100

Constraints this file lives under, all of them deliberate:

  * stdlib only. No pip install on a box that sits in the print path.
  * never raises. An unhandled traceback here stops printing for the building.
  * fail-open by default (PLAN.md §4), and says so loudly on stderr and to syslog, so a
    coverage gap is never mistaken for a clean pass.
  * small. All real logic is in the API; this is a shim.
"""

from __future__ import annotations

import configparser
import json
import mimetypes
import os
import socket
import sys
import syslog
import tempfile
import urllib.error
import urllib.parse
import urllib.request
import uuid

CUPS_BACKEND_OK = 0
CUPS_BACKEND_FAILED = 1
CUPS_BACKEND_HOLD = 3
CUPS_BACKEND_STOP = 4
CUPS_BACKEND_CANCEL = 5

CONFIG_PATHS = ("/etc/janus-print/backend.conf", "/usr/local/etc/janus-print/backend.conf")
BACKEND_DIR = "/usr/lib/cups/backend"

DEFAULTS = {
    "api_url": "http://localhost:8080",
    "timeout": "30",
    "fail_mode": "open",  # open | closed
    "max_bytes": str(200 * 1024 * 1024),
    "verify_tls": "true",
    "syslog_host": "",
    "syslog_port": "514",
}


# --- logging -----------------------------------------------------------------
# CUPS routes stderr into the queue's error_log when the prefix is one of its levels.


def log(level: str, message: str) -> None:
    sys.stderr.write("%s: %s\n" % (level, message))
    sys.stderr.flush()


def audit(config, message: str, severity: int = syslog.LOG_WARNING) -> None:
    """Emit directly to syslog as well as CUPS.

    Deliberately independent of the API: the events that matter most are the ones raised
    when the API is unreachable, and those must still reach the SIEM.
    """
    try:
        syslog.openlog("janus-print-backend", syslog.LOG_PID, syslog.LOG_AUTHPRIV)
        syslog.syslog(severity, message)
        syslog.closelog()
    except Exception:
        pass

    host = config.get("syslog_host", "")
    if not host:
        return
    try:
        line = "<%d>janus-print-backend: %s" % (13 * 8 + 4, message)
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.settimeout(2.0)
        sock.sendto(line.encode("utf-8"), (host, int(config.get("syslog_port", "514"))))
        sock.close()
    except Exception:
        pass


# --- config ------------------------------------------------------------------


def load_config():
    values = dict(DEFAULTS)
    parser = configparser.ConfigParser()
    for path in CONFIG_PATHS:
        if os.path.exists(path):
            try:
                parser.read(path)
                if parser.has_section("backend"):
                    values.update(dict(parser.items("backend")))
            except Exception as exc:
                log("ERROR", "unreadable config %s: %s" % (path, exc))
    for key in list(values):
        env = os.environ.get("JANUS_PRINT_BACKEND_" + key.upper())
        if env:
            values[key] = env
    return values


# --- device URI --------------------------------------------------------------


def originating_host(options):
    """Pull the workstation name out of argv[5].

    CUPS does not put REMOTE_HOST in the backend's environment — it passes
    job-originating-host-name inside the options string instead. Without this, every job
    from every laptop is attributed to the print server rather than to the machine that
    sent it, which makes the SOC trail nearly useless for a shared queue.
    """
    if not options:
        return ""
    for token in options.split():
        if token.startswith("job-originating-host-name="):
            return token.split("=", 1)[1].strip("'\"")
    return ""


def real_device_uri(device_uri):
    """janus://<scheme>/<rest> -> <scheme>://<rest>. Returns (scheme, uri)."""
    if not device_uri or not device_uri.startswith("janus://"):
        return None, None
    remainder = device_uri[len("janus://") :]
    if "/" not in remainder:
        return None, None
    scheme, rest = remainder.split("/", 1)
    # Real backend names include hyphens (cups-pdf, cups-brf, driverless-fax). Anything
    # outside this set is refused rather than guessed at — a wrong guess would exec the
    # wrong binary as root.
    if not scheme or not all(c.isalnum() or c in "-_." for c in scheme):
        return None, None
    if scheme.startswith((".", "-")) or "/" in scheme:
        return None, None
    return scheme, "%s://%s" % (scheme, rest)


# --- HTTP (stdlib multipart) -------------------------------------------------


def encode_multipart(fields, filename, payload):
    boundary = "----janus%s" % uuid.uuid4().hex
    body = bytearray()
    for key, value in fields.items():
        body.extend(("--%s\r\n" % boundary).encode())
        body.extend(
            ('Content-Disposition: form-data; name="%s"\r\n\r\n' % key).encode()
        )
        body.extend(("%s\r\n" % value).encode("utf-8", "replace"))

    content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
    body.extend(("--%s\r\n" % boundary).encode())
    body.extend(
        (
            'Content-Disposition: form-data; name="document"; filename="%s"\r\n'
            % os.path.basename(filename)
        ).encode()
    )
    body.extend(("Content-Type: %s\r\n\r\n" % content_type).encode())
    body.extend(payload)
    body.extend(b"\r\n")
    body.extend(("--%s--\r\n" % boundary).encode())
    return bytes(body), "multipart/form-data; boundary=%s" % boundary


def http_json(url, timeout):
    request = urllib.request.Request(url, method="GET")
    with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310
        return json.loads(response.read().decode("utf-8"))


def post_for_inspection(config, fields, spool_path):
    with open(spool_path, "rb") as handle:
        payload = handle.read()

    body, content_type = encode_multipart(fields, spool_path, payload)
    url = config["api_url"].rstrip("/") + "/api/v1/inspect"
    request = urllib.request.Request(url, data=body, method="POST")
    request.add_header("Content-Type", content_type)
    with urllib.request.urlopen(request, timeout=float(config["timeout"])) as response:  # noqa: S310
        return json.loads(response.read().decode("utf-8"))


# --- job body ----------------------------------------------------------------


def spool_job(argv):
    """Return (path, cleanup). CUPS passes a filename as argv[6], or the job on stdin."""
    if len(argv) > 6 and argv[6]:
        return argv[6], False

    handle, path = tempfile.mkstemp(prefix="janus-spool-", suffix=".prn")
    with os.fdopen(handle, "wb") as out:
        while True:
            chunk = sys.stdin.buffer.read(1024 * 256)
            if not chunk:
                break
            out.write(chunk)
    os.chmod(path, 0o600)
    return path, True


# --- pass-through ------------------------------------------------------------


def exec_real_backend(scheme, uri, argv, spool_path):
    """Hand the job to the real backend, preserving argv so print options survive."""
    path = os.path.join(BACKEND_DIR, scheme)
    if not os.path.exists(path):
        log("ERROR", "real backend %s not found" % path)
        return CUPS_BACKEND_STOP

    os.environ["DEVICE_URI"] = uri
    forwarded = [path, argv[1], argv[2], argv[3], argv[4], argv[5], spool_path]

    log("DEBUG", "releasing to %s" % uri)
    try:
        os.execv(path, forwarded)  # replaces this process; CUPS sees the real exit code
    except OSError as exc:
        log("ERROR", "could not exec %s: %s" % (path, exc))
        return CUPS_BACKEND_STOP
    return CUPS_BACKEND_STOP  # unreachable


# --- main --------------------------------------------------------------------


def discovery():
    """No arguments: CUPS is asking what devices we provide."""
    sys.stdout.write(
        'network janus "Unknown" "Janus Print DLP" "Janus Print DLP inspection backend"\n'
    )
    return CUPS_BACKEND_OK


def main(argv):
    if len(argv) == 1:
        return discovery()
    if len(argv) < 6:
        log("ERROR", "usage: janus job-id user title copies options [file]")
        return CUPS_BACKEND_FAILED

    config = load_config()
    job_id, username, title, copies, options = argv[1], argv[2], argv[3], argv[4], argv[5]
    queue = os.environ.get("PRINTER", "unknown")
    device_uri = os.environ.get("DEVICE_URI", "")

    scheme, uri = real_device_uri(device_uri)
    if scheme is None:
        log("ERROR", "bad device URI %r; expected janus://<scheme>/<host>/<path>" % device_uri)
        return CUPS_BACKEND_STOP

    spool_path, temporary = None, False
    try:
        # 1. Already cleared by an analyst? Resuming a held job re-runs this backend, so
        #    without this check a released job would be inspected and held all over again.
        try:
            preflight = http_json(
                "%s/api/v1/preflight?queue=%s&cups_job_id=%s"
                % (config["api_url"].rstrip("/"), urllib.parse.quote(queue), urllib.parse.quote(job_id)),
                timeout=min(3.0, float(config["timeout"])),
            )
        except Exception as exc:
            log("DEBUG", "preflight unavailable (%s); inspecting normally" % exc)
            preflight = {}

        spool_path, temporary = spool_job(argv)
        size = os.path.getsize(spool_path)

        if preflight.get("pass_through"):
            log("INFO", "job %s pre-cleared: %s" % (job_id, preflight.get("reason", "")))
            return exec_real_backend(scheme, uri, argv, spool_path)

        # 2. Oversized jobs are not inspected inline — reading a 500MB CAD plot into the
        #    API would blow the deadline for everyone behind it in the queue.
        if size > int(config["max_bytes"]):
            message = "job %s from %s on %s is %d bytes, over the inline limit" % (
                job_id,
                username,
                queue,
                size,
            )
            log("WARN", message)
            audit(config, "OVERSIZE_UNINSPECTED " + message)
            if config["fail_mode"] == "closed":
                return CUPS_BACKEND_HOLD
            return exec_real_backend(scheme, uri, argv, spool_path)

        fields = {
            "cups_job_id": job_id,
            "queue": queue,
            "username": username,
            "hostname": originating_host(options) or os.environ.get("REMOTE_HOST", ""),
            "title": title,
            "copies": copies,
            "options": options,
        }

        try:
            verdict = post_for_inspection(config, fields, spool_path)
        except (urllib.error.URLError, socket.timeout, OSError, ValueError) as exc:
            # 3. The inspector is unreachable or too slow. This is the decision that keeps
            #    the product deployed: halting every printer in the building is worse than
            #    the leak we are trying to stop. Fail open, but never silently.
            message = (
                "INSPECTION_FAILED_OPEN job=%s user=%s queue=%s reason=%s"
                % (job_id, username, queue, exc)
            )
            if config["fail_mode"] == "closed":
                message = message.replace("FAILED_OPEN", "FAILED_CLOSED")
                log("ERROR", "%s; holding job" % message)
                audit(config, message, syslog.LOG_ERR)
                return CUPS_BACKEND_HOLD
            log("ERROR", "%s; releasing uninspected" % message)
            audit(config, message, syslog.LOG_ERR)
            return exec_real_backend(scheme, uri, argv, spool_path)

        action = verdict.get("action", "allow")
        reason = verdict.get("reason", "")
        log(
            "INFO",
            "job %s verdict=%s score=%.2f %dms %s"
            % (job_id, action, verdict.get("score", 0.0), verdict.get("inline_ms", 0), reason),
        )

        if action == "block":
            log("ERROR", "job %s blocked: %s" % (job_id, reason))
            return CUPS_BACKEND_CANCEL
        if action == "hold":
            # CUPS keeps the job in the queue; the console releases or cancels it later.
            log("ERROR", "job %s held for review: %s" % (job_id, reason))
            return CUPS_BACKEND_HOLD

        return exec_real_backend(scheme, uri, argv, spool_path)

    except Exception as exc:  # noqa: BLE001 - nothing may escape this function
        log("ERROR", "backend error: %s" % exc)
        audit(config, "BACKEND_ERROR job=%s error=%s" % (job_id, exc), syslog.LOG_ERR)
        if config.get("fail_mode") == "closed":
            return CUPS_BACKEND_HOLD
        if spool_path:
            return exec_real_backend(scheme, uri, argv, spool_path)
        return CUPS_BACKEND_FAILED
    finally:
        # Only reached when exec did not happen; execv never returns.
        if temporary and spool_path and os.path.exists(spool_path):
            try:
                os.unlink(spool_path)
            except OSError:
                pass


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        sys.exit(CUPS_BACKEND_FAILED)
